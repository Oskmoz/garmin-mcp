# Copier en .env (chmod 600) puis remplir. Ne jamais committer le .env.

# Clé API personnelle Garmin (Garmin Connect Web > paramètres > clé API personnelle)
GARMIN_PERSONAL_API_KEY=

# Jeton que Claude enverra à chaque requête. Générer avec : openssl rand -hex 32
MCP_AUTH_TOKEN=

# Traefik : à adapter à ton installation
MCP_DOMAIN=garmin-mcp.example.com
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
